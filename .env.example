# Copy to .env and fill in. Never commit .env.

# Postgres connection used by the app at runtime.
# Local:  postgresql://USER@localhost:5432/bharatreefer_dev?schema=public
# Neon:   use the *pooled* connection string (host contains "-pooler"), e.g.
#         postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=""

# Optional. Connection used by the Prisma CLI for migrations.
# Neon:   use the *direct* connection string (same host without "-pooler").
# Leave empty locally; migrations then fall back to DATABASE_URL.
DIRECT_URL=""

# Secret used to hash visitor IPs for rate limiting (raw IPs are never stored).
# Generate with: openssl rand -hex 32
IP_HASH_SALT=""

# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Email notifications are sent through Resend (https://resend.com).
# Without RESEND_API_KEY the site works normally and logs each email instead of sending it.
RESEND_API_KEY=""

# Sender shown on outgoing email, e.g. "Bharat Reefer <quotes@bharatreefer.com>".
# The domain must be verified in Resend. Required once RESEND_API_KEY is set.
EMAIL_FROM=""

# Optional. Where new-request alerts go. Defaults to the email in src/config/site.ts.
DISPATCH_EMAIL=""
