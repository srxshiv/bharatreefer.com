// Prisma schema for Bharat Reefer.
// The connection URL lives in prisma7.config.ts (CLI) and src/lib/db.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Temperature band the cargo must be held at.
enum Material {
  FROZEN
  CHILLED
  AMBIENT

  @@map("material")
}

/// Whether the consignment takes dedicated vehicles or shares one.
enum LoadType {
  FULL_LOAD
  PART_LOAD

  @@map("load_type")
}

/// Where a quote request sits in the dispatch pipeline.
enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  COMPLETED
  LOST
  SPAM

  @@map("quote_status")
}

model QuoteRequest {
  id        String      @id @default(cuid())
  /// Short human-readable code shared with the customer, e.g. "BR-7K3Q9F".
  reference String      @unique
  status    QuoteStatus @default(NEW)

  originState      String @map("origin_state")
  originCity       String @map("origin_city")
  destinationState String @map("destination_state")
  destinationCity  String @map("destination_city")

  material   Material
  quantityKg Int       @map("quantity_kg")
  loadType   LoadType  @map("load_type")
  /// Vehicle plan suggested at submission time: [{ capacityKg, count }].
  /// Stored as a snapshot because the fleet configuration can change later.
  truckPlan  Json      @map("truck_plan")
  pickupDate DateTime? @map("pickup_date") @db.Date
  notes      String?

  contactName String  @map("contact_name")
  /// Normalised to E.164, e.g. "+919871094268".
  phone       String
  email       String?

  /// Freight quoted to the customer, in whole rupees. Null until dispatch has quoted.
  quotedAmount Int? @map("quoted_amount")

  /// Salted SHA-256 of the submitter's IP. Used for rate limiting; the raw IP is never stored.
  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  activities  QuoteActivity[]
  assignments TruckAssignment[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([phone])
  @@index([ipHash, createdAt])
  @@map("quote_requests")
}

/// What kind of entry a row in a quote's timeline is.
enum QuoteActivityType {
  NOTE
  STATUS_CHANGE
  PRICE_CHANGE
  NOTIFICATION
  ASSIGNMENT

  @@map("quote_activity_type")
}

/// Timeline of a quote request: internal notes, status and price changes, emails sent.
model QuoteActivity {
  id             String            @id @default(cuid())
  quoteRequestId String            @map("quote_request_id")
  quoteRequest   QuoteRequest      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  /// Null for entries the system wrote, or when the author's account was removed.
  authorId       String?           @map("author_id")
  author         AdminUser?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type           QuoteActivityType
  /// The note text, or a one-line description of what changed.
  body           String
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([quoteRequestId, createdAt(sort: Desc)])
  @@map("quote_activities")
}

/// Someone who can sign in to the admin panel.
model AdminUser {
  id           String   @id @default(cuid())
  /// Always stored lowercase.
  email        String   @unique
  name         String
  /// scrypt hash, see src/lib/password.ts.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  activities QuoteActivity[]

  @@map("admin_users")
}

model Session {
  id        String    @id @default(cuid())
  /// SHA-256 of the token held in the browser cookie. The token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Failed sign-in attempts, kept briefly to slow down password guessing.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

/// Everything the business can edit about the public site. A single row with id "default".
/// Columns that may be null fall back to text generated from the other settings.
model SiteSettings {
  id String @id @default("default")

  name       String
  tagline    String
  /// E.164, e.g. "+919871094268".
  phone      String
  /// E.164. Null hides the WhatsApp links.
  whatsapp   String?
  /// Public contact address shown on the site.
  email      String
  /// Where new-request alerts go. Null means the public email.
  alertEmail String? @map("alert_email")

  addressStreet String @map("address_street")
  addressCity   String @map("address_city")
  addressRegion String @map("address_region")

  /// Days the desk is open: ["Monday", ...].
  hoursDays    Json   @map("hours_days")
  /// "HH:MM", 24-hour, India time.
  hoursOpen    String @map("hours_open")
  hoursClose   String @map("hours_close")
  /// How quickly dispatch commits to replying, e.g. "24 hours".
  responseTime String @map("response_time")

  /// Null means the automatic heading built from the fleet, e.g. "Reefer trucks from 900 kg to 22 tonnes."
  heroHeading String? @map("hero_heading")
  heroIntro   String  @map("hero_intro")
  /// [{ title, body }]. Null means the automatic three steps.
  steps       Json?
  /// [{ question, answer }]. Null means the automatic questions.
  faqs        Json?

  /// Public page sections: { [sectionId]: { visible, eyebrow?, title?, intro? } }. Missing keys use the defaults.
  sections     Json?
  /// Bar across the top of the public site: { enabled, text, linkLabel?, linkUrl?, tone }.
  announcement Json?

  /// Smallest and largest consignment accepted through the quote form, in kilograms.
  minQuantityKg        Int @map("min_quantity_kg")
  maxQuantityKg        Int @map("max_quantity_kg")
  /// A load gets a dedicated truck when it fills at least this much of the smallest truck that fits it.
  dedicatedFillPercent Int @map("dedicated_fill_percent")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

/// How each temperature band is presented. One row per Material; the bands themselves are fixed.
model TemperatureBand {
  id        Material @id
  label     String
  /// Set-point range as shown to customers, e.g. "−18 to −22 °C".
  range     String
  summary   String
  /// string[]
  examples  Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("temperature_bands")
}

/// A truck size in the fleet. The quote form plans loads onto these.
model TruckSize {
  id         String   @id @default(cuid())
  /// Payload in kilograms.
  capacityKg Int      @unique @map("capacity_kg")
  /// Optional model or body name shown next to the capacity, e.g. "Tata 407".
  name       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("truck_sizes")
}

/// A photo of the fleet shown on the public site. Stored resized, as WebP.
model FleetPhoto {
  id          String   @id @default(cuid())
  caption     String
  position    Int
  width       Int
  height      Int
  contentType String   @map("content_type")
  bytes       Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([position])
  @@map("fleet_photos")
}

/// AVAILABLE: at the depot, loads can be placed on it. ON_TRIP: on the road with its loads.
/// MAINTENANCE: off the road.
enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE

  @@map("vehicle_status")
}

/// A truck in the fleet, identified by its registration plate.
model Vehicle {
  id            String        @id @default(cuid())
  /// Uppercase without spaces or dashes, e.g. "DL01LA4521".
  plateNumber   String        @unique @map("plate_number")
  /// Payload in kilograms. Groups the truck with a size in the fleet.
  capacityKg    Int           @map("capacity_kg")
  model         String?
  driverName    String?       @map("driver_name")
  /// E.164
  driverPhone   String?       @map("driver_phone")
  /// Temperature band the truck is set up for. Null: not fixed. Shown as a guide; mixing is allowed.
  temperature   Material?
  /// Body length in feet, for information.
  lengthFt      Float?        @map("length_ft")
  /// Number of tyres, for information.
  tyres         Int?
  status        VehicleStatus @default(AVAILABLE)
  /// When the current trip started. Set only while ON_TRIP.
  tripStartedAt DateTime?     @map("trip_started_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments TruckAssignment[]

  @@index([capacityKg])
  @@map("vehicles")
}

/// A confirmed load, or part of one, placed on a truck. A truck can carry several part loads,
/// a heavy load can span several trucks, and one truck can carry parts of the same request on
/// different trips.
model TruckAssignment {
  id             String       @id @default(cuid())
  vehicleId      String       @map("vehicle_id")
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  quoteRequestId String       @map("quote_request_id")
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  /// How much of the request's weight travels on this truck.
  loadKg         Int          @map("load_kg")
  /// Set when the trip carrying it ended. Null while the load is on board.
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([vehicleId, deliveredAt])
  @@index([quoteRequestId])
  @@map("truck_assignments")
}

/// A lane the business runs regularly, shown on the public site (beta).
model Route {
  id               String   @id @default(cuid())
  originState      String   @map("origin_state")
  originCity       String   @map("origin_city")
  destinationState String   @map("destination_state")
  destinationCity  String   @map("destination_city")
  /// e.g. "36 to 48 hours"
  transitTime      String?  @map("transit_time")
  /// e.g. "Daily departures"
  frequency        String?
  position         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([position])
  @@map("routes")
}
